# Database Configuration
# Update this with your PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/blog_sermaye?schema=public"

# JWT Secret
# Generate a strong random string for production
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Application URL
# The base URL of your application (used in email links)
APP_URL="http://localhost:3000"

# Email Configuration (SMTP)
# For Gmail:
# 1. Enable 2-factor authentication
# 2. Generate an app-specific password
# 3. Use that password below
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-specific-password"
EMAIL_FROM="Blog Sermaye <noreply@blogsermaye.com>"

# Alternative Email Providers:
# SendGrid: smtp.sendgrid.net (port 587)
# Mailgun: smtp.mailgun.org (port 587)
# AWS SES: email-smtp.region.amazonaws.com (port 587)
